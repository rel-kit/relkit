{
  "name": "relkit",
  "homepage": "https://github.com/rel-kit/relkit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "check": "bun run scripts/check-boundaries.ts",
    "typecheck": "tsc -b --pretty false && bun packages/cli/dist/index.js check --project-root examples/commerce --json",
    "lint": "bun run scripts/lint.ts",
    "test": "bun run scripts/test-all.ts",
    "test:types": "bun run scripts/test-types.ts",
    "test:packages": "bun run scripts/test-packages.ts",
    "test:unit": "bun test ./tests/unit ./tests/schema",
    "test:compiler": "bun test --timeout 15000 ./tests/compiler ./tests/graph",
    "test:contracts": "bun test ./tests/contracts",
    "test:integration": "bun test ./tests/integration",
    "test:restart": "bun test ./tests/restart",
    "test:inspector": "bun test ./tests/inspector",
    "test:inspector:browser": "bun run scripts/test-inspector-browser.ts",
    "test:mcp:inspector": "RELKIT_MCP_INSPECTOR_CLI=1 bun test packages/runtime-hono/mcp.test.ts",
    "test:e2e": "bun run scripts/test-e2e.ts",
    "test:generator": "bun run scripts/test-generator.ts",
    "test:scaffold": "RELKIT_TEST_DOCKER=1 bun run scripts/pack-and-smoke-create-relkit.ts",
    "test:examples": "bunx turbo run check typecheck test build --filter='./examples/*'",
    "test:docs": "bunx turbo run check test --filter=@relkit/docs",
    "test:deployment": "bun test ./tests/deployment",
    "test:aws-integration": "bun test ./tests/deployment/aws-integration.test.ts",
    "test:container": "bun test ./tests/container",
    "test:local-docker": "RELKIT_TEST_DOCKER=1 bun test ./tests/integration/local-docker-services.test.ts",
    "test:security": "bun test ./tests/security",
    "test:jobs:unit": "bun test packages/jobs packages/providers-local packages/engine/materialize-jobs.test.ts packages/testing/jobs.test.ts",
    "test:jobs:types": "bun x tsc -p tests/types/tsconfig.json --pretty false",
    "test:jobs:contracts": "bun test tests/contracts/jobs.test.ts packages/jobs/task-wire.test.ts packages/jobs/authoring-boundaries.test.ts",
    "test:jobs:docker": "RELKIT_TEST_DOCKER=1 bun run test:jobs:matrix",
    "test:jobs:restart": "bun test tests/restart/jobs.test.ts",
    "test:jobs:client": "bun test packages/client/jobs-watch.test.ts packages/client/pending.test.ts",
    "test:jobs:coverage": "vitest run --config scripts/jobs-coverage/vitest.config.ts --coverage",
    "test:jobs:mutation": "stryker run scripts/jobs-coverage/stryker.config.mjs && bun scripts/jobs-coverage/verify-mutation.ts",
    "test:jobs:quality": "bun run test:jobs:coverage && bun run test:jobs:mutation",
    "test:jobs:inspector": "bun test tests/inspector/job-name-filters.test.ts packages/inspector-api/jobs.test.ts",
    "test:jobs:providers": "bun tests/jobs/compatibility/inngest-native.ts && bun tests/jobs/compatibility/inngest-native-phase0.ts && bun tests/jobs/compatibility/effect-mq-native.ts && bun tests/jobs/compatibility/trigger-docker.ts",
    "test:jobs:matrix": "bun tests/jobs/compatibility/capability-matrix.ts",
    "test:all": "bun run scripts/test-all.ts",
    "relkit:local": "bun scripts/relkit-local.ts",
    "build": "bun run scripts/build.ts",
    "verify": "bun run scripts/verify.ts",
    "prepush": "bun install --frozen-lockfile && bun x prettier --check AGENTS.md README.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md CHANGELOG.md RELEASE_NOTES.md package.json turbo.json tsconfig.base.json tsconfig.json .prettierrc.json eslint.config.mjs playwright.config.ts .changeset .github apps examples integrations packages scripts templates tests docs/testing.md && bun run lint && bun run check && bun run konsistent -- validate && bun run scripts/check-observability-sinks.ts && bun x turbo run typecheck --filter='./packages/*' --filter='./integrations/catalog' --filter='./integrations/packages/*' --output-logs=errors-only && bun x tsc -b --pretty false && bun run test:types && bun run test:unit && bun test tests/compiler/manifest.test.ts tests/compiler/graph-construction.test.ts tests/compiler/job-names.test.ts tests/graph && bun run test:contracts && bun run test:security",
    "prepush:full": "docker info >/dev/null && bun run verify && bun run test:jobs:docker && bun run test:scaffold && bun run test:container && bun run test:local-docker && bun run test:deployment && bun run test:inspector:browser && bun run test:e2e",
    "konsistent": "konsistent",
    "changeset": "node ./node_modules/@changesets/cli/bin.js",
    "version:packages": "bun run scripts/version-packages.ts",
    "release:sync": "bun run scripts/sync-release.ts --write",
    "release:check": "bun run scripts/release-check.ts --readiness --allow-dirty --skip-build",
    "release:pack": "bun run scripts/release-check.ts"
  },
  "packageManager": "bun@1.3.10",
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@effect/sql-pg": "4.0.0-rc.115",
    "@hughescr/stryker-bun-runner": "1.4.0",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@types/bun": "1.3.10",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "5.0.1",
    "agent-browser": "0.35.1",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0-rc.115",
    "effect-mq": "0.7.0",
    "eslint": "10.9.1",
    "inngest": "4.20.0",
    "konsistent": "1.0.0-beta.4",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.115"
  },
  "engines": {
    "bun": "1.3.10"
  },
  "workspaces": [
    "apps/*",
    "examples/*",
    "integrations/catalog",
    "integrations/packages/*",
    "packages/*"
  ]
}
