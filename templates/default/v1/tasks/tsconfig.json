{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [{ "name": "@relkit/cli/editor" }],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@app/*": ["src/*"] }
  },
  "files": [".relkit/generated/route-module-checks.ts"],
  "include": ["src", "tests", "examples"]
}
