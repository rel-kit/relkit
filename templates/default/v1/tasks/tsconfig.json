{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "typeRoots": ["./node_modules/@types"],
    "plugins": [{ "name": "@relkit/cli/editor" }],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": { "@app/*": ["./src/*"] }
  },
  "files": [".relkit/generated/route-module-checks.ts", ".relkit/generated/context-registry.d.ts"],
  "include": ["src/**/*.ts", "tests/**/*.ts", "relkit.config.ts"],
  "exclude": ["node_modules", ".relkit"]
}
