{
  "name": "my-app",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun run check && bun run --parallel dev:api dev:web",
    "dev:api": "RELKIT_ALLOWED_ORIGINS=http://127.0.0.1:3001 relkit dev",
    "dev:web": "next dev web --hostname 127.0.0.1 --port 3001",
    "check": "relkit check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "bun test",
    "build": "relkit build && next build web",
    "start": "relkit start"
  },
  "dependencies": {
    "@langchain/langgraph": "1.4.14",
    "@relkit/app": "0.4.0",
    "@relkit/client": "0.4.0",
    "@relkit/local": "0.4.0",
    "@tanstack/react-query": "5.102.3",
    "langchain": "1.5.10",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@relkit/cli": "0.4.0",
    "@relkit/testing": "0.4.0",
    "@types/bun": "1.3.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3"
  }
}
