{
  "name": "my-app",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "RELKIT_ALLOWED_ORIGINS=http://127.0.0.1:3001 relkit dev",
    "dev:web": "next dev web --hostname 127.0.0.1 --port 3001",
    "check": "relkit check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "bun test",
    "build": "relkit build && next build web",
    "start": "relkit start"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.14",
    "@orpc/tanstack-query": "1.16.1",
    "@relkit/client": "0.8.4",
    "@relkit/langchain": "0.7.15",
    "@relkit/local": "0.7.14",
    "@scalar/hono-api-reference": "0.12.9",
    "@tanstack/react-query": "5.102.3",
    "langchain": "1.5.10",
    "langsmith": "0.10.8",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "relkit": "0.8.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@relkit/cli": "0.8.8",
    "@relkit/testing": "0.8.4",
    "@types/bun": "1.3.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3"
  }
}
