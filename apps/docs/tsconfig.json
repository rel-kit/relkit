{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    ".blume",
    ".next",
    "dist",
    "content/_snippets",
    "examples/frontend",
    "examples/orders-tutorial/steps",
    "examples/jobs/providers"
  ]
}
