---
/**
 * Document shell for the blog: the docs header (tabs, search, theme toggle), then the
 * railed frame and footer around Blume-rendered content, with Blume's theme so post
 * bodies keep docs styling. The head stays ours for article Open Graph tags and JSON-LD.
 */
import data from "blume:data";
import { THEME_INIT_SCRIPT } from "blume/components/layout/head-scripts.ts";
import "blume:theme";
import SiteHeader from "../site-header.astro";
import BlogFooter from "./BlogFooter.astro";
import { blogFeed } from "./posts";
import "./blog.css";

interface Props {
  readonly title: string;
  readonly description: string;
  readonly path: string;
  /** Site-relative Open Graph image, e.g. `/og/blog/slug.png`. */
  readonly ogImage: string;
  readonly ogType?: "website" | "article";
  readonly jsonLd?: Record<string, unknown>;
  readonly published?: Date;
}

const { title, description, path, ogImage, ogType = "website", jsonLd, published } = Astro.props;
const site = (data.config.site ?? "https://relkit.dev").replace(/\/$/, "");
const canonical = `${site}${path}`;
const image = `${site}${ogImage}`;
const hasFeed = data.feeds.some((feed) => feed.href === blogFeed);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hasFeed && <link rel="alternate" type="application/rss+xml" title="RELKIT Blog" href={blogFeed} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="RELKIT" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/metadata/favicon.ico" sizes="any" />
    <link rel="icon" href="/metadata/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/metadata/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/metadata/site.webmanifest" />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script data-mode={data.config.theme.mode} is:inline set:html={THEME_INIT_SCRIPT} />
  </head>
  <body class="blog-body">
    <a class="blog-skip" href="#blog-content">Skip to content</a>
    <SiteHeader route={path} />
    <div class="blog-rails">
      <main id="blog-content">
        <slot />
      </main>
      <BlogFooter feed={hasFeed} />
    </div>
  </body>
</html>
