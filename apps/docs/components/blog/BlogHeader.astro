---
/** The landing header for blog pages, with search and a theme toggle the light-only landing omits. */
import Logo from "./Logo.astro";
---

<header class="blog-header">
  <div class="blog-header-inner">
    <a class="blog-brand" href="/" aria-label="RELKIT home">
      <Logo size={28} />
      RELKIT
    </a>
    <nav class="blog-nav" aria-label="Main navigation">
      <a class="blog-nav-hide-sm" href="/docs">Documentation</a>
      <a href="/blog" aria-current="page">Blog</a>
      <a class="blog-nav-hide-sm" href="https://github.com/rel-kit/relkit">
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <button class="blog-icon-button" type="button" data-blog-search aria-label="Search">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>
      <button class="blog-icon-button" type="button" data-blog-theme aria-label="Toggle dark mode">
        <svg class="blog-theme-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
        <svg class="blog-theme-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
      <a class="blog-button" href="/docs/learn/create-an-app">
        Start building <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<script>
  document.querySelector("[data-blog-search]")?.addEventListener("click", () => {
    document.querySelector<HTMLElement>(".blog-search [data-blume-search-open]")?.click();
  });
  document.querySelector("[data-blog-theme]")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("blume-theme", next);
    } catch {
      // Storage can be blocked; the toggle still applies for this page view.
    }
  });
</script>
