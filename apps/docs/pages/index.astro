---
/**
 * Keeps the marketing document independent of the documentation stylesheet while sharing the
 * docs header: its utilities are generated by the landing's own Tailwind (see app/globals.css).
 */
import { LandingPage } from "../components/landing/page";
import { highlightHeroExamples } from "../components/landing/highlight-hero-examples";
import { THEME_INIT_SCRIPT } from "blume/components/layout/head-scripts.ts";
import SiteHeader from "../components/site-header.astro";
import data from "blume:data";
import "../app/globals.css";
import "../app/landing.css";
import "../app/hero.css";
import "../app/hero-examples.css";
import "../components/landing/fonts.css";

const examples = await highlightHeroExamples();
const title = "RelKit — The TypeScript backend framework";
// Must match POSITIONING in scripts/positioning.ts; the release check compares them.
const description = "The TypeScript backend framework where you write the business logic. RelKit wires the APIs, jobs, events, agents and typed client, and gives you, and your coding agent, a live map of the app.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://relkit.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RelKit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://relkit.dev/metadata/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://relkit.dev/metadata/og.png" />
    <link rel="icon" href="/metadata/favicon.ico" sizes="any" />
    <link rel="icon" href="/metadata/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/metadata/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/metadata/site.webmanifest" />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script data-mode={data.config.theme.mode} is:inline set:html={THEME_INIT_SCRIPT} />
  </head>
  <body class="flex min-h-screen flex-col">
    <SiteHeader route="/" />
    <LandingPage examples={examples} client:load />
  </body>
</html>
