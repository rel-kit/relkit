---
/** Keeps the marketing document independent of the documentation header and stylesheet. */
import { LandingPage } from "../components/landing/page";
import { highlightHeroExamples } from "../components/landing/highlight-hero-examples";
import Search from "blume/components/layout/Search.astro";
import data from "blume:data";
import "../app/globals.css";
import "../app/landing.css";
import "../app/hero.css";
import "../app/hero-examples.css";
import "../components/landing/fonts.css";

const examples = await highlightHeroExamples();
const title = "Relkit — One application model for TypeScript backends";
const description = "Build typed TypeScript backends from one checked application graph across development, tests, HTTP, async work, inspection, and deployment.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://relkit.up.railway.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RELKIT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://relkit.up.railway.app/metadata/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://relkit.up.railway.app/metadata/og.png" />
    <link rel="icon" href="/metadata/favicon.ico" sizes="any" />
    <link rel="icon" href="/metadata/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/metadata/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/metadata/site.webmanifest" />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="flex min-h-screen flex-col">
    <LandingPage examples={examples} client:load />
    <div class="landing-search">
      <Search navigation={data.navigation} />
    </div>
  </body>
</html>

<style>
  .landing-search { display: contents; }
  .landing-search :global([data-blume-search-open]) { display: none; }
</style>
