{
  "name": "@relkit/docs",
  "homepage": "https://github.com/rel-kit/relkit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run generate && next build",
    "check": "bun run generate:check && tsc --noEmit && bun run check:jsdoc && bun run check:links && bun run check:search",
    "check:jsdoc": "bun run scripts/check-jsdoc.ts",
    "check:links": "bun run scripts/check-links.ts",
    "check:search": "bun run scripts/check-search.ts",
    "dev": "bun run generate && next dev --hostname 127.0.0.1 --port 3001",
    "generate": "bun run scripts/generate.ts",
    "generate:check": "bun run scripts/generate.ts --check",
    "start": "next start --hostname 0.0.0.0",
    "test": "bun test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@relkit/cli": "workspace:*",
    "@splinetool/react-spline": "4.1.0",
    "@splinetool/runtime": "1.12.98",
    "fumadocs-core": "16.16.1",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.16.1",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "4.5.0",
    "simple-icons": "16.34.0"
  },
  "devDependencies": {
    "@effect/docgen": "catalog:",
    "@relkit/app": "workspace:*",
    "@relkit/aws": "workspace:*",
    "@relkit/better-auth": "workspace:*",
    "@relkit/client": "workspace:*",
    "@relkit/docker": "workspace:*",
    "@relkit/drizzle": "workspace:*",
    "@relkit/effect-mq": "workspace:*",
    "@relkit/inngest": "workspace:*",
    "@relkit/integrations": "workspace:*",
    "@relkit/otlp": "workspace:*",
    "@relkit/pulumi": "workspace:*",
    "@relkit/realtime": "workspace:*",
    "@relkit/redis": "workspace:*",
    "@relkit/s3": "workspace:*",
    "@relkit/sentry": "workspace:*",
    "@relkit/testing": "workspace:*",
    "@relkit/trigger": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "2.0.14",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "create-relkit": "workspace:*",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  }
}
