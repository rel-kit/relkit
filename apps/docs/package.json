{
  "name": "@relkit/docs",
  "homepage": "https://github.com/rel-kit/relkit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run generate && blume build --strict",
    "check": "bun run generate:check && tsc --noEmit && bun run check:jsdoc && bun run check:links && bun run check:search",
    "check:jsdoc": "bun run scripts/check-jsdoc.ts",
    "check:links": "blume validate --strict",
    "check:search": "bun run scripts/check-search.ts",
    "dev": "bun run generate && NODE_OPTIONS=--max-old-space-size=8192 blume dev --host=127.0.0.1 --port=3001",
    "generate": "bun run scripts/generate.ts",
    "generate:check": "bun run scripts/generate.ts --check",
    "test": "bun test tests/*.test.ts",
    "test:browser": "playwright test --config=playwright.config.ts",
    "test:installations": "bun x turbo run build --cwd=../.. --filter='./packages/*' --filter='./integrations/*' --filter='./integrations/packages/*' --output-logs=errors-only && bun run scripts/check-installation-workflows.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "1.2.18",
    "@relkit/cli": "workspace:*",
    "blume": "2.2.5",
    "fumadocs-core": "16.16.1",
    "fumadocs-ui": "16.16.1",
    "lucide-react": "catalog:",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0",
    "simple-icons": "16.34.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "astro": "7.4.2",
    "@effect/docgen": "catalog:",
    "@relkit/app": "workspace:*",
    "@relkit/provider": "workspace:*",
    "@relkit/providers-local": "workspace:*",
    "@relkit/aws": "workspace:*",
    "@relkit/better-auth": "workspace:*",
    "@relkit/client": "workspace:*",
    "@relkit/cloudflare": "workspace:*",
    "@relkit/contracts": "workspace:*",
    "@relkit/docker": "workspace:*",
    "@relkit/drizzle": "workspace:*",
    "@relkit/effect-mq": "workspace:*",
    "@relkit/inngest": "workspace:*",
    "@relkit/integrations": "workspace:*",
    "@relkit/local": "workspace:*",
    "@relkit/otlp": "workspace:*",
    "@relkit/pulumi": "workspace:*",
    "@relkit/realtime": "workspace:*",
    "@relkit/redis": "workspace:*",
    "@relkit/s3": "workspace:*",
    "@relkit/sentry": "workspace:*",
    "@relkit/testing": "workspace:*",
    "@relkit/trigger": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/query-core": "5.102.3",
    "@types/mdx": "2.0.14",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "0.186.0",
    "create-relkit": "workspace:*",
    "drizzle-kit": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  }
}
