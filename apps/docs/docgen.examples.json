{
  "compilerOptions": {
    "baseUrl": ".",
    "exactOptionalPropertyTypes": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@relkit/app/*": ["../../packages/app/src/*.ts"],
      "@relkit/app/jobs": ["../../packages/app/src/jobs.ts"],
      "@relkit/app/tasks": ["../../packages/app/src/tasks.ts"],
      "@relkit/better-auth/react": ["../../packages/better-auth/src/react.ts"],
      "@relkit/better-auth/drizzle": ["../../packages/better-auth/src/drizzle.ts"],
      "@relkit/client/server": ["../../packages/client/src/server.ts"],
      "@relkit/client/server/tanstack-query": ["../../packages/client/src/server-context.ts"],
      "@relkit/client/react": ["../../packages/client/src/react/index.ts"],
      "@relkit/client/tanstack-query": ["../../packages/client/src/tanstack-query.ts"],
      "@relkit/client/jobs": ["../../packages/client/src/jobs/index.ts"],
      "@relkit/contracts/jobs": ["../../packages/contracts/src/jobs.ts"],
      "@relkit/drizzle/internal": ["../../packages/drizzle/src/internal.ts"],
      "@relkit/drizzle/sqlite": ["../../packages/drizzle/src/sqlite.ts"],
      "@relkit/drizzle/pg": ["../../packages/drizzle/src/pg.ts"],
      "@relkit/drizzle/mysql": ["../../packages/drizzle/src/mysql.ts"],
      "@relkit/langchain/testing": ["../../integrations/packages/langchain/src/testing/agents.ts"],
      "@relkit/testing/drizzle": ["../../packages/testing/src/drizzle.ts"],
      "@relkit/testing/better-auth": ["../../packages/testing/src/better-auth.ts"],
      "@relkit/jobs/adapter": ["../../packages/jobs/src/adapter.ts"],
      "@relkit/jobs/server": ["../../packages/jobs/src/server.ts"],
      "@relkit/jobs/legacy": ["../../packages/jobs/src/legacy.ts"],
      "@relkit/*": ["../../packages/*/src/index.ts", "../../integrations/packages/*/src/index.ts"],
      "drizzle-orm/*": ["../../packages/drizzle/node_modules/drizzle-orm/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["bun"],
    "verbatimModuleSyntax": true
  }
}
