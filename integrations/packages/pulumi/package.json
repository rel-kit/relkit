{
  "name": "@relkit/pulumi",
  "version": "0.8.2",
  "description": "Pulumi deployment-engine integration for RELKIT.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "integrations/packages/pulumi"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    }
  },
  "relkit": {
    "integration": {
      "id": "pulumi",
      "dependencies": [
        {
          "package": "@pulumi/pulumi",
          "supportedRange": "3.259.0",
          "installSection": "devDependencies",
          "capabilities": [
            "engine"
          ],
          "phases": [
            "deploy"
          ]
        }
      ],
      "exports": {
        "authoring": ".",
        "deploymentEngine": "./engine"
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@relkit/deploy-pulumi": "workspace:*",
    "@relkit/deploy": "workspace:*"
  },
  "peerDependencies": {
    "@pulumi/pulumi": "catalog:"
  },
  "peerDependenciesMeta": {
    "@pulumi/pulumi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pulumi/pulumi": "catalog:"
  }
}
