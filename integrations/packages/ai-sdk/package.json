{
  "name": "@relkit/ai-sdk",
  "version": "0.8.4",
  "description": "Optional Vercel AI SDK agent adapter for RelKit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "integrations/packages/ai-sdk"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=22.13.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "dependencies": {
    "relkit": "workspace:*"
  },
  "peerDependencies": {
    "ai": "7.0.153"
  },
  "devDependencies": {
    "@relkit/testing": "workspace:*",
    "ai": "7.0.153",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts"
  },
  "relkit": {
    "maturity": "labs",
    "integration": {
      "id": "ai-sdk",
      "exports": {
        "authoring": ".",
        "runtime": {
          "export": "./runtime",
          "registrations": [
            {
              "capability": "agent-execution",
              "adapterId": "ai-sdk",
              "protocolVersion": 1
            }
          ]
        }
      },
      "dependencies": [
        {
          "package": "ai",
          "supportedRange": "7.0.153",
          "installSection": "dependencies",
          "capabilities": [
            "agent-execution"
          ],
          "phases": [
            "check",
            "build",
            "runtime"
          ]
        }
      ]
    }
  }
}
