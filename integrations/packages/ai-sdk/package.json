{
  "name": "@relkit/ai-sdk",
  "version": "0.3.0",
  "description": "AI SDK model integration for RELKIT.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "integrations/packages/ai-sdk"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "relkit": {
    "integration": {
      "id": "ai-sdk",
      "exports": {
        "authoring": ".",
        "runtime": {
          "export": "./runtime",
          "registrations": [
            {
              "capability": "model",
              "adapterId": "ai-sdk",
              "protocolVersion": 1
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.42",
    "@ai-sdk/openai": "4.0.47",
    "@relkit/agents": "workspace:*",
    "@relkit/provider": "workspace:*"
  }
}
