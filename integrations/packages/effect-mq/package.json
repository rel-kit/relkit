{
  "name": "@relkit/effect-mq",
  "version": "1.0.0",
  "description": "Effect MQ retryable-jobs integration for RELKIT.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "integrations/packages/effect-mq"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./local-recipe": {
      "types": "./dist/local-recipe/index.d.ts",
      "import": "./dist/local-recipe/index.js"
    },
    "./deployment": {
      "types": "./dist/deployment/index.d.ts",
      "import": "./dist/deployment/index.js"
    }
  },
  "relkit": {
    "integration": {
      "id": "effect-mq",
      "exports": {
        "authoring": ".",
        "runtime": {
          "export": "./runtime",
          "registrations": [
            {
              "capability": "job",
              "adapterId": "effect-mq",
              "protocolVersion": 1
            }
          ]
        },
        "localRecipe": "./local-recipe",
        "deploymentEngine": "./deployment"
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.0-rc.115",
    "@relkit/contracts": "workspace:*",
    "@relkit/jobs": "workspace:*",
    "@relkit/local-service": "workspace:*",
    "@relkit/provider": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0-rc.115",
    "effect-mq": "0.7.0"
  }
}
