{
  "name": "@relkit/redis",
  "version": "0.2.0",
  "description": "Redis integration for RELKIT.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "integrations/packages/redis"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./local-recipe": {
      "types": "./dist/local-recipe/index.d.ts",
      "import": "./dist/local-recipe/index.js"
    }
  },
  "relkit": {
    "integration": {
      "id": "redis",
      "exports": {
        "authoring": ".",
        "runtime": {
          "export": "./runtime",
          "registrations": [
            {
              "capability": "cache",
              "adapterId": "redis",
              "protocolVersion": 1
            }
          ]
        },
        "localRecipe": "./local-recipe"
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@relkit/cache": "workspace:*",
    "@relkit/contracts": "workspace:*",
    "@relkit/local-service": "workspace:*",
    "@relkit/provider": "workspace:*"
  }
}
