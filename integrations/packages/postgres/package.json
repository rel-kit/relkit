{
  "name": "@relkit/postgres",
  "version": "0.1.0",
  "description": "Durable Postgres jobs, events and schedules for RelKit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "integrations/packages/postgres"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=22.13.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "import": "./dist/drizzle/index.js"
    }
  },
  "relkit": {
    "maturity": "labs",
    "integration": {
      "id": "postgres",
      "exports": {
        "authoring": ".",
        "runtime": {
          "export": "./runtime",
          "registrations": [
            {
              "capability": "job",
              "adapterId": "postgres-job",
              "protocolVersion": 1
            },
            {
              "capability": "event",
              "adapterId": "postgres-event",
              "protocolVersion": 1
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "effect": "catalog:",
    "relkit": "workspace:*"
  },
  "devDependencies": {
    "@relkit/testing": "workspace:*",
    "drizzle-orm": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  }
}
