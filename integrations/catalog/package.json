{
  "name": "@relkit/integrations",
  "version": "0.8.0",
  "description": "Metadata-only catalog of independently selected RELKIT integrations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "integrations/catalog"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "relkit": {
    "catalog": {
      "./aws": "@relkit/aws",
      "./cloudflare": "@relkit/cloudflare",
      "./docker": "@relkit/docker",
      "./local": "@relkit/local",
      "./otlp": "@relkit/otlp",
      "./pulumi": "@relkit/pulumi",
      "./redis": "@relkit/redis",
      "./s3": "@relkit/s3",
      "./sentry": "@relkit/sentry",
      "./inngest": "@relkit/inngest",
      "./trigger": "@relkit/trigger",
      "./effect-mq": "@relkit/effect-mq",
      "./langchain": "@relkit/langchain"
    }
  },
  "scripts": {
    "build": "tsc -b && bun run ../../scripts/prune-moved-authoring-artifacts.ts catalog",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
}
