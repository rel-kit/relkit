FROM oven/bun:1.3.10 AS bun

FROM node:24-bookworm-slim

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /app

COPY . .
RUN bun install --frozen-lockfile
RUN RELKIT_DOCGEN_CONCURRENCY=1 bun x turbo run build --filter=@relkit/docs

ENV PORT=3000
EXPOSE 3000

CMD ["bun", "--cwd=apps/docs", "run", "start"]
