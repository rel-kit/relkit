--- before/src/services/database/migrations/0001-order-status.sql
+++ after/src/services/database/migrations/0001-order-status.sql
@@ -0,0 +1,4 @@
+CREATE TABLE order_status (
+  order_id TEXT PRIMARY KEY,
+  status TEXT NOT NULL CHECK (status IN ('pending', 'paid', 'shipped', 'cancelled'))
+);
--- before/src/services/database/order-status.ts
+++ after/src/services/database/order-status.ts
@@ -0,0 +1,14 @@
+import type { Database } from "bun:sqlite";
+
+export type OrderStatus = "pending" | "paid" | "shipped" | "cancelled";
+const statuses = new Set<OrderStatus>(["pending", "paid", "shipped", "cancelled"]);
+
+export function setOrderStatus(db: Database, orderId: string, status: OrderStatus): void {
+  if (!orderId.trim() || !statuses.has(status)) throw new TypeError("Invalid order status");
+  db.query("INSERT INTO order_status (order_id, status) VALUES (?, ?) ON CONFLICT(order_id) DO UPDATE SET status = excluded.status").run(orderId, status);
+}
+
+export function getOrderStatus(db: Database, orderId: string): OrderStatus | null {
+  const row = db.query("SELECT status FROM order_status WHERE order_id = ?").get(orderId) as { status: OrderStatus } | null;
+  return row?.status ?? null;
+}
--- before/tests/order-status.test.ts
+++ after/tests/order-status.test.ts
@@ -0,0 +1,18 @@
+import { expect, test } from "bun:test";
+import { openDatabase } from "../src/services/database/service.js";
+import { getOrderStatus, setOrderStatus } from "../src/services/database/order-status.js";
+
+test("order status migration, storage, update and rejection", async () => {
+  const db = openDatabase(":memory:");
+  try {
+    db.exec(await Bun.file(new URL("../src/services/database/migrations/0001-order-status.sql", import.meta.url)).text());
+    expect(getOrderStatus(db, "missing")).toBeNull();
+    setOrderStatus(db, "order-1", "pending");
+    expect(getOrderStatus(db, "order-1")).toBe("pending");
+    setOrderStatus(db, "order-1", "shipped");
+    expect(getOrderStatus(db, "order-1")).toBe("shipped");
+    expect(() => setOrderStatus(db, "", "pending")).toThrow();
+    expect(() => setOrderStatus(db, "order-1", "invalid" as never)).toThrow();
+    expect(getOrderStatus(db, "order-1")).toBe("shipped");
+  } finally { db.close(); }
+});
