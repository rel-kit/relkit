--- before/src/routes/health/route.ts
+++ after/src/routes/health/route.ts
@@ -0,0 +1,3 @@
+import { defineRoute } from "@relkit/app/routes";
+import health from "@app/services/health/service.js";
+export const GET = defineRoute({ target: health.health });
--- before/src/services/health/functions/health.function.ts
+++ after/src/services/health/functions/health.function.ts
@@ -0,0 +1,12 @@
+import { defineFunction } from "@relkit/app/functions";
+import { z } from "@relkit/app/schema";
+
+export default defineFunction({
+  id: "health.check",
+  input: z.object({ verbose: z.boolean().optional() }),
+  output: z.object({ status: z.literal("ok"), detail: z.string().optional() }),
+  handler: async ({ verbose }) => ({
+    status: "ok" as const,
+    ...(verbose ? { detail: "Backend is ready" } : {}),
+  }),
+});
--- before/src/services/health/service.ts
+++ after/src/services/health/service.ts
@@ -0,0 +1,3 @@
+import { defineService } from "@relkit/app/services";
+import health from "./functions/health.function.js";
+export default defineService({ functions: { health } });
--- before/tests/health.test.ts
+++ after/tests/health.test.ts
@@ -0,0 +1,11 @@
+import { expect, test } from "bun:test";
+import { invokeFunction } from "@relkit/testing";
+import health from "../src/services/health/service.js";
+import { GET } from "../src/routes/health/route.js";
+
+test("health validates optional input and explicit output", async () => {
+  expect(await invokeFunction(health.health, {})).toEqual({ status: "ok" });
+  expect(await invokeFunction(health.health, { verbose: true })).toEqual({ status: "ok", detail: "Backend is ready" });
+  await expect(invokeFunction(health.health, { verbose: "invalid" } as never)).rejects.toBeDefined();
+  expect(GET.target).toBe(health.health);
+});
