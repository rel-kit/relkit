{
  "name": "@relkit/agents",
  "version": "0.6.0",
  "description": "RELKIT agent authoring API; prefer @relkit/app/agents in applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/agents"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@langchain/core": "catalog:",
    "@langchain/langgraph": "catalog:",
    "@relkit/contracts": "workspace:*",
    "@relkit/functions": "workspace:*",
    "@relkit/invocation": "workspace:*",
    "@relkit/schema": "workspace:*",
    "@relkit/tools": "workspace:*",
    "effect": "catalog:",
    "langchain": "catalog:",
    "langsmith": "0.10.8"
  },
  "peerDependencies": {
    "deepagents": "catalog:"
  },
  "peerDependenciesMeta": {
    "deepagents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "@langchain/langgraph-checkpoint-mongodb": "1.4.1",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@langchain/langgraph-checkpoint-redis": "1.0.11",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@relkit/buckets": "workspace:*",
    "deepagents": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts"
  }
}
