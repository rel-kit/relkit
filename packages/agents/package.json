    }
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.14",
    "@relkit/contracts": "workspace:*",
    "@relkit/functions": "workspace:*",
    "@relkit/invocation": "workspace:*",
    "@relkit/schema": "workspace:*",
    "@relkit/tools": "workspace:*",
    "langchain": "1.5.10",
    "langsmith": "0.10.2"
  },
  "peerDependencies": {
    "deepagents": "1.13.3"
  },
  "peerDependenciesMeta": {
    "deepagents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/langgraph-checkpoint-mongodb": "1.4.1",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@langchain/langgraph-checkpoint-redis": "1.0.11",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@relkit/buckets": "workspace:*",
    "deepagents": "1.13.3"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
