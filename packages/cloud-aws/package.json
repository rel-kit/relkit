{
  "name": "@relkit/cloud-aws",
  "version": "0.0.0",
  "description": "Unsupported internal AWS deployment components for RELKIT; use @relkit/cli.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/cloud-aws"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "dependencies": {
    "@relkit/agents": "workspace:*",
    "@relkit/app": "workspace:*",
    "@relkit/buckets": "workspace:*",
    "@relkit/cache": "workspace:*",
    "@relkit/contracts": "workspace:*",
    "@relkit/engine": "workspace:*",
    "@relkit/events": "workspace:*",
    "@relkit/graph": "workspace:*",
    "@relkit/jobs": "workspace:*",
    "@relkit/observability": "workspace:*",
    "@relkit/providers-standard": "workspace:*",
    "@pulumi/aws": "7.42.0",
    "@pulumi/awsx": "3.8.0",
    "@pulumi/pulumi": "3.258.0"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
}
