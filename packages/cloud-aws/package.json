{
  "name": "@relkit/cloud-aws",
  "version": "0.7.15",
  "description": "Unsupported internal AWS deployment components for RelKit; use @relkit/cli.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/cloud-aws"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "dependencies": {
    "@pulumi/aws": "catalog:",
    "@pulumi/awsx": "3.10.0",
    "@pulumi/pulumi": "catalog:",
    "relkit": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  },
  "relkit": {
    "maturity": "labs"
  }
}
