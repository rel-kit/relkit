{
  "name": "@relkit/drizzle",
  "version": "0.8.0",
  "description": "Drizzle ORM integration for RELKIT functions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/drizzle"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "import": "./dist/pg.js"
    },
    "./mysql": {
      "types": "./dist/mysql.d.ts",
      "import": "./dist/mysql.js"
    }
  },
  "dependencies": {
    "@relkit/contracts": "workspace:*",
    "@relkit/invocation": "workspace:*",
    "@relkit/provider": "workspace:*",
    "effect": "catalog:",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "drizzle-orm": "catalog:",
    "mysql2": "3.23.1",
    "@effect/vitest": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:",
    "mysql2": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "relkit": {
    "integration": {
      "id": "drizzle",
      "exports": {
        "authoring": [
          ".",
          "./sqlite",
          "./pg",
          "./mysql"
        ]
      },
      "dependencies": [
        {
          "package": "drizzle-orm",
          "supportedRange": "1.0.0-rc.5-169397b",
          "installSection": "dependencies",
          "capabilities": [
            "drizzle"
          ],
          "phases": [
            "check",
            "build",
            "runtime"
          ]
        },
        {
          "package": "mysql2",
          "supportedRange": ">=2.0.0",
          "installSection": "devDependencies",
          "capabilities": [
            "mysql"
          ],
          "phases": [
            "check",
            "build"
          ]
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
}
