{
  "name": "@relkit/observability-local",
  "version": "0.1.0",
  "description": "Explicit local diagnostic history and worker storage for RELKIT inspection.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/observability-local"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/local/worker.d.ts",
      "import": "./dist/local/worker.js"
    },
    "./internal/local-worker": {
      "types": "./dist/local/duckdb-worker.d.ts",
      "import": "./dist/local/duckdb-worker.js"
    }
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@relkit/contracts": "workspace:*",
    "@relkit/observability": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts"
  }
}
