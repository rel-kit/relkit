{
  "name": "@relkit/schema",
  "version": "0.7.13",
  "description": "RelKit schema API; prefer @relkit/app/schema in applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@valibot/to-json-schema": ">=1.3.0 <2",
    "arktype": ">=2.1.0 <3",
    "valibot": ">=1.0.0 <2",
    "zod": ">=4.2.0 <5"
  },
  "peerDependenciesMeta": {
    "@valibot/to-json-schema": {
      "optional": true
    },
    "arktype": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@valibot/to-json-schema": "1.8.0",
    "@vitest/coverage-v8": "catalog:",
    "arktype": "2.2.9",
    "valibot": "1.5.0",
    "vitest": "catalog:",
    "zod": "4.6.7"
  },
  "relkit": {
    "maturity": "core"
  }
}
