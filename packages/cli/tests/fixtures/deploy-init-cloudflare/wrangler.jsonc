// Generated by `relkit deploy init cloudflare`. Bindings come from the application graph;
// rerun the command after adding caches, buckets, realtime or durable work. Secrets such as
// DATABASE_URL are set with `wrangler secret put`, never here.
{
  "name": "my-app",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "./node_modules/.bin/relkit build --runtime workers"
  },
  "assets": {
    "directory": ".relkit/build/public"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "CACHE"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELKIT_REALTIME",
        "class_name": "RelkitRealtimeState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "relkit-realtime-v1",
      "new_sqlite_classes": [
        "RelkitRealtimeState"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "RELKIT_WORK",
        "queue": "my-app-relkit-work"
      }
    ],
    "consumers": [
      {
        "queue": "my-app-relkit-work",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 10
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
