# Generated by `relkit deploy init railway`. Builds the application from source.
FROM oven/bun:1.3.10@sha256:b86c67b531d87b4db11470d9b2bd0c519b1976eee6fcd71634e73abfa6230d2e AS build
WORKDIR /src
COPY . .
RUN bun install --frozen-lockfile
RUN ./node_modules/.bin/relkit build --runtime bun

FROM oven/bun:1.3.10@sha256:b86c67b531d87b4db11470d9b2bd0c519b1976eee6fcd71634e73abfa6230d2e AS dependencies
WORKDIR /src
COPY . .
RUN bun install --frozen-lockfile --production
RUN mkdir -p node_modules

FROM oven/bun:1.3.10@sha256:b86c67b531d87b4db11470d9b2bd0c519b1976eee6fcd71634e73abfa6230d2e
ARG SOURCE_DATE_EPOCH=0
WORKDIR /app
COPY --from=build /src/.relkit/build/ ./
COPY --from=dependencies /src/node_modules ./node_modules
RUN mkdir -p .relkit/state .relkit/observability && chown -R bun:bun .relkit
USER bun
ENV NODE_ENV=production
ENV RELKIT_DURABLE_STATE=external
EXPOSE 3000
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 CMD ["bun", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT??3000)+'/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["bun", "run", "--no-env-file", "server/index.js"]
