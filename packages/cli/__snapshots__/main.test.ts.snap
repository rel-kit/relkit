  "graph": 
"DESCRIPTION
  Inspect deterministic application graphs

USAGE
  relkit graph <subcommand> [flags]

FLAGS
  --json    Emit machine-readable output

GLOBAL FLAGS
  --help, -h                          Show help information
  --version, -v                       Show version information
  --completions <bash|zsh|fish|sh>    Print shell completion script (choices: bash, zsh, fish, sh)

SUBCOMMANDS
  print    Print a canonical graph
  check    Validate a graph and optional hash
  diff     Compare graph compatibility
EXAMPLES
  # Inspect deterministic application graphs
  relkit graph"
,
  "graph check": 
"DESCRIPTION
  Validate a graph and optional hash

USAGE
  relkit graph check [flags] [<graph>]

ARGUMENTS
  graph string    Graph JSON path (optional)

FLAGS
  --json                   Emit machine-readable output
  --project-root string    Application directory (defaults to cwd)
  --hash string            Expected sha256 graph hash

GLOBAL FLAGS
  --help, -h                          Show help information
  --version, -v                       Show version information
  --completions <bash|zsh|fish|sh>    Print shell completion script (choices: bash, zsh, fish, sh)

EXAMPLES
  # Validate a graph and optional hash
  relkit graph check"
,
  "graph diff": 
"DESCRIPTION
  Compare graph compatibility

USAGE
  relkit graph diff [flags] <before> <after>

ARGUMENTS
  before string    Previous graph path
  after string     Next graph path

FLAGS
  --json                   Emit machine-readable output
  --project-root string    Application directory (defaults to cwd)

GLOBAL FLAGS
  --help, -h                          Show help information
  --version, -v                       Show version information
  --completions <bash|zsh|fish|sh>    Print shell completion script (choices: bash, zsh, fish, sh)

EXAMPLES
  # Compare graph compatibility
  relkit graph diff"
,
