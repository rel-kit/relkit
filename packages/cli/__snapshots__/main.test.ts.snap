// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`renders focused help for every command and nested subcommand 1`] = `
{
  "build": 
"DESCRIPTION
  Build a deployable application

USAGE
  relkit build [flags]

FLAGS
  --json                   Emit machine-readable output
  --project-root string    Application directory (defaults to cwd)

GLOBAL FLAGS
  --help, -h                          Show help information
  --version, -v                       Show version information
  --completions <bash|zsh|fish|sh>    Print shell completion script (choices: bash, zsh, fish, sh)

EXAMPLES
  # Build a deployable application
  relkit build"
,
  "check": 
"DESCRIPTION
  Compile and validate the application

USAGE
  relkit check [flags]

FLAGS
  --json                   Emit machine-readable output
  --project-root string    Application directory (defaults to cwd)

GLOBAL FLAGS
  --help, -h                          Show help information
  --version, -v                       Show version information
  --completions <bash|zsh|fish|sh>    Print shell completion script (choices: bash, zsh, fish, sh)

EXAMPLES
  # Compile and validate the application
  relkit check"
,
  "create": 
"DESCRIPTION
  Create a new RELKIT application

USAGE
  relkit create [flags] <name>

ARGUMENTS
  name string    npm package and application name

FLAGS
  --json                     Emit machine-readable output
  --template choice          Starter template (choices: minimal, api, agent)
  --cloud choice             Cloud provider (choices: aws, none)
  --deploy choice            Deployment adapter (choices: pulumi, none)
  --directory string         Destination directory
  --install                  Install generated project setup
  --no-install               No install generated project setup
  --git                      Git generated project setup
  --no-git                   No git generated project setup
  --examples                 Examples generated project setup
  --no-examples              No examples generated project setup
  --force-empty-directory    Allow an existing empty destination

GLOBAL FLAGS
  --help, -h                          Show help information
  --version, -v                       Show version information
  --completions <bash|zsh|fish|sh>    Print shell completion script (choices: bash, zsh, fish, sh)

EXAMPLES
  # Create a new RELKIT application
  relkit create"
,
  "deploy": 
"DESCRIPTION
  Manage Pulumi deployments

USAGE
  relkit deploy <subcommand> [flags]

FLAGS
  --json    Emit machine-readable output

GLOBAL FLAGS
  --help, -h                          Show help information
  --version, -v                       Show version information
  --completions <bash|zsh|fish|sh>    Print shell completion script (choices: bash, zsh, fish, sh)

SUBCOMMANDS
  init       Init the Pulumi stack
  preview    Preview the Pulumi stack
  up         Up the Pulumi stack
  refresh    Refresh the Pulumi stack
  outputs    Outputs the Pulumi stack
  destroy    Destroy the Pulumi stack
EXAMPLES
  # Manage Pulumi deployments
  relkit deploy"
,
  "deploy destroy": 
"DESCRIPTION
  Destroy the Pulumi stack

USAGE
  relkit deploy destroy [flags]

FLAGS
  --json                       Emit machine-readable output
  --project-root string        Application directory (defaults to cwd)
  --stack string               Pulumi stack name (default: development)
  --backend string             cloud, local, or object-storage URL
  --config key=value           Set a non-secret Pulumi value; repeatable
  --config-secret key=value    Set a secret Pulumi value; repeatable
  --non-interactive, --yes     Approve protected operations

GLOBAL FLAGS
  --help, -h                          Show help information
  --version, -v                       Show version information
  --completions <bash|zsh|fish|sh>    Print shell completion script (choices: bash, zsh, fish, sh)

EXAMPLES
  # Destroy the Pulumi stack
  relkit deploy destroy"
,
