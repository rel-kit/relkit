  "relkit": [
    "DESCRIPTION",
    "  Convention-first TypeScript application framework",
    "",
    "USAGE",
    "  relkit <subcommand> [flags]",
    "",
    "FLAGS",
    "  --json    Emit machine-readable output",
    "",
    "GLOBAL FLAGS",
    "  --help, -h                          Show help information",
    "  --version, -v                       Show version information",
    "  --completions <bash|zsh|fish|sh>    Print shell completion script (choices: bash, zsh, fish, sh)",
    "",
    "SUBCOMMANDS",
    "  create    Create a new RELKIT application",
    "  add       Add a compile-ready artifact",
    "  dev       Run app, inspector, OpenAPI, and Scalar",
    "  check     Compile descriptors, infer eligible IDs, and validate the application",
    "  build     Build the checked graph, manifest, OpenAPI, and client",
    "  start     Start a built application",
    "  graph     Inspect deterministic application graphs",
    "  env       Inspect value-free environment contracts",
    "  local     Manage project-scoped local services",
    "  doctor    Check local prerequisites and ports",
    "  deploy    Manage Pulumi deployments",
    "  client    Generate a client from a running application",
    "EXAMPLES",
    "  # Convention-first TypeScript application framework",
    "  relkit",
  ],
  "start": [
    "DESCRIPTION",
    "  Start a built application",
    "",
    "USAGE",
    "  relkit start [flags]",
    "",
    "FLAGS",
    "  --json                   Emit machine-readable output",
    "  --project-root string    Application directory (defaults to cwd)",
    "  --port integer           Application port",
    "",
    "GLOBAL FLAGS",
    "  --help, -h                          Show help information",
    "  --version, -v                       Show version information",
    "  --completions <bash|zsh|fish|sh>    Print shell completion script (choices: bash, zsh, fish, sh)",
    "",
    "EXAMPLES",
    "  # Start a built application",
    "  relkit start",
  ],
