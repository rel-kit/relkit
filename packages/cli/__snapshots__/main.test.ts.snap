,
  "env": 
"DESCRIPTION
  Inspect value-free environment contracts

USAGE
  relkit env <subcommand> [flags]

FLAGS
  --json    Emit machine-readable output

GLOBAL FLAGS
  --help, -h                          Show help information
  --version, -v                       Show version information
  --completions <bash|zsh|fish|sh>    Print shell completion script (choices: bash, zsh, fish, sh)

SUBCOMMANDS
  check      Validate environment values
  list       List environment value status
  explain    Explain one environment variable
  example    Render or write a safe .env example
EXAMPLES
  # Inspect value-free environment contracts
  relkit env"
,
  "env check": 
"DESCRIPTION
  Validate environment values

USAGE
  relkit env check [flags]

FLAGS
  --json                         Emit machine-readable output
  --project-root string          Application directory (defaults to cwd)
  --environment, --env string    Provider environment

GLOBAL FLAGS
  --help, -h                          Show help information
  --version, -v                       Show version information
  --completions <bash|zsh|fish|sh>    Print shell completion script (choices: bash, zsh, fish, sh)

EXAMPLES
