{
  "name": "@relkit/cli",
  "version": "0.0.5",
  "description": "The RELKIT development, build, inspection, and deployment CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "bin": {
    "relkit": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./help": {
      "types": "./dist/cli-help-model.d.ts",
      "import": "./dist/cli-help-model.js"
    }
  },
  "dependencies": {
    "@relkit/agents": "workspace:*",
    "@relkit/app": "workspace:*",
    "@relkit/config": "workspace:*",
    "@relkit/cloud-aws": "workspace:*",
    "@relkit/compiler": "workspace:*",
    "@relkit/client-generator": "workspace:*",
    "@relkit/contracts": "workspace:*",
    "@relkit/deploy": "workspace:*",
    "@relkit/deploy-pulumi": "workspace:*",
    "@relkit/diagnostics": "workspace:*",
    "create-relkit": "workspace:*",
    "@relkit/graph": "workspace:*",
    "@relkit/engine": "workspace:*",
    "@relkit/inspector-api": "workspace:*",
    "@relkit/invocation": "workspace:*",
    "@relkit/observability": "workspace:*",
    "@relkit/providers-standard": "workspace:*",
    "@relkit/runtime-effect": "workspace:*",
    "@relkit/runtime-hono": "workspace:*",
    "@relkit/supervisor": "workspace:*",
    "effect": "4.0.0-beta.107",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "optionalDependencies": {
    "@sentry/bun": "10.71.0"
  },
  "scripts": {
    "build": "tsc -b && bun run ../../scripts/package-inspector.ts",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
}
