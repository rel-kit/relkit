{
  "name": "@zsys/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "zsys": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./help": {
      "types": "./dist/cli-help-model.d.ts",
      "import": "./dist/cli-help-model.js"
    }
  },
  "dependencies": {
    "@zsys/config": "workspace:*",
    "@zsys/cloud-aws": "workspace:*",
    "@zsys/compiler": "workspace:*",
    "@zsys/contracts": "workspace:*",
    "@zsys/deploy": "workspace:*",
    "@zsys/deploy-pulumi": "workspace:*",
    "@zsys/diagnostics": "workspace:*",
    "create-zsys": "workspace:*",
    "@zsys/graph": "workspace:*",
    "@zsys/engine": "workspace:*",
    "@zsys/inspector-api": "workspace:*",
    "@zsys/observability": "workspace:*",
    "@zsys/providers-standard": "workspace:*",
    "@zsys/runtime-effect": "workspace:*",
    "@zsys/runtime-hono": "workspace:*",
    "@zsys/supervisor": "workspace:*",
    "effect": "4.0.0-beta.107",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "build": "tsc -b && bun run ../../scripts/package-inspector.ts",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
}
