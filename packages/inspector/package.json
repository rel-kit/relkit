{
  "name": "@relkit/inspector",
  "version": "0.2.1",
  "description": "Standalone RelKit development inspector, collector, and local diagnostic history.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/inspector"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=20.9.0"
  },
  "type": "module",
  "bin": {
    "relkit-inspector": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./observability-local": {
      "types": "./dist/observability-local/index.d.ts",
      "import": "./dist/observability-local/index.js"
    },
    "./observability-local/internal/local-worker": {
      "types": "./dist/observability-local/local/duckdb-worker.d.ts",
      "import": "./dist/observability-local/local/duckdb-worker.js"
    },
    "./observability-local/worker": {
      "types": "./dist/observability-local/local/worker.d.ts",
      "import": "./dist/observability-local/local/worker.js"
    }
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "effect": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "relkit": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc -b && bun run ../../scripts/package-inspector.ts",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  },
  "relkit": {
    "maturity": "core"
  }
}
