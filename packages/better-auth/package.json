{
  "name": "@relkit/better-auth",
  "version": "0.8.3",
  "description": "Better Auth integration for RELKIT routes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/better-auth"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    }
  },
  "dependencies": {
    "@relkit/client": "workspace:*",
    "@relkit/contracts": "workspace:*",
    "@relkit/invocation": "workspace:*",
    "@relkit/provider": "workspace:*",
    "@relkit/routes": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "4.20250121.0",
    "@relkit/drizzle": "workspace:*",
    "better-auth": "catalog:",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@relkit/drizzle": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250121.0",
    "@relkit/drizzle": "workspace:*",
    "better-auth": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/react": "catalog:",
    "drizzle-orm": "catalog:",
    "react": "catalog:",
    "vitest": "catalog:"
  },
  "relkit": {
    "integration": {
      "id": "better-auth",
      "exports": {
        "authoring": [
          ".",
          "./drizzle"
        ]
      },
      "dependencies": [
        {
          "package": "better-auth",
          "supportedRange": "1.7.1",
          "installSection": "dependencies",
          "capabilities": [
            "better-auth"
          ],
          "phases": [
            "check",
            "build",
            "runtime"
          ]
        },
        {
          "package": "@cloudflare/workers-types",
          "supportedRange": "4.20250121.0",
          "installSection": "devDependencies",
          "capabilities": [
            "better-auth"
          ],
          "phases": [
            "check",
            "build"
          ]
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
}
