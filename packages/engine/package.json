{
  "name": "@relkit/engine",
  "version": "0.8.3",
  "description": "Unsupported internal RELKIT execution engine; use @relkit/app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    "./internal/server-runtime": {
      "types": "./dist/internal/server-runtime.d.ts",
      "import": "./dist/internal/server-runtime.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@relkit/app": "workspace:*",
    "@relkit/buckets": "workspace:*",
    "@relkit/cache": "workspace:*",
    "@relkit/contracts": "workspace:*",
    "@relkit/events": "workspace:*",
    "@relkit/graph": "workspace:*",
    "@relkit/invocation": "workspace:*",
    "@relkit/jobs": "workspace:*",
    "@relkit/observability": "workspace:*",
    "@relkit/provider": "workspace:*",
    "@relkit/runtime-effect": "workspace:*",
    "@relkit/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@relkit/compiler": "workspace:*",
    "@relkit/providers-local": "workspace:*",
    "typescript": "catalog:",
    "@effect/vitest": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
}
