    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && bun ../../scripts/package-create-relkit-templates.ts",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false && bun ../../scripts/package-create-relkit-templates.ts"
  },
