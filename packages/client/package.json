{
  "name": "@relkit/client",
  "version": "0.4.0",
  "description": "Typed RELKIT client helpers, including TanStack Query integration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./dist/server.js"
    },
    "./tanstack-query": {
      "types": "./dist/tanstack-query.d.ts",
      "import": "./dist/tanstack-query.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./build/next": {
      "types": "./dist/build/next.d.ts",
      "import": "./dist/build/next.js",
      "default": "./dist/build/next.js"
    },
    "./build/vite": {
      "types": "./dist/build/vite.d.ts",
      "import": "./dist/build/vite.js",
      "default": "./dist/build/vite.js"
    }
  },
  "dependencies": {
    "@relkit/contracts": "workspace:*",
    "@relkit/invocation": "workspace:*",
    "@relkit/realtime": "workspace:*",
    "@orpc/client": "2.0.0-beta.34",
    "@orpc/contract": "2.0.0-beta.31",
    "@orpc/tanstack-query": "2.0.0-beta.31"
  },
  "peerDependencies": {
    "@tanstack/query-core": ">=5.80.2",
    "@tanstack/react-query": ">=5.80.2",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@tanstack/react-query": "5.102.3",
    "react": "19.2.8"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
}
