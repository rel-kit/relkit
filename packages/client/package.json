{
  "name": "@relkit/client",
  "version": "0.7.10",
  "description": "Typed RELKIT client helpers, including TanStack Query integration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./dist/server.js"
    },
    "./server/tanstack-query": {
      "types": "./dist/server-context.d.ts",
      "bun": "./dist/server-context.js"
    },
    "./tanstack-query": {
      "types": "./dist/tanstack-query.d.ts",
      "import": "./dist/tanstack-query.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "import": "./dist/jobs/index.js"
    },
    "./build/next": {
      "types": "./dist/build/next.d.ts",
      "import": "./dist/build/next.js",
      "default": "./dist/build/next.js"
    },
    "./build/vite": {
      "types": "./dist/build/vite.d.ts",
      "import": "./dist/build/vite.js",
      "default": "./dist/build/vite.js"
    }
  },
  "dependencies": {
    "@relkit/contracts": "workspace:*",
    "@relkit/invocation": "workspace:*",
    "@relkit/realtime": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@orpc/tanstack-query": "2.0.0-beta.31",
    "@tanstack/query-core": "catalog:peer",
    "@tanstack/react-query": "catalog:peer",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "@orpc/tanstack-query": {
      "optional": true
    },
    "@tanstack/query-core": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@effect/vitest": "catalog:",
    "vitest": "catalog:",
    "@types/react": "catalog:",
    "@orpc/tanstack-query": "2.0.0-beta.31",
    "@tanstack/query-core": "5.102.3",
    "@tanstack/react-query": "catalog:",
    "react": "catalog:"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false"
  }
}
