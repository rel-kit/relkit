{
  "name": "@relkit/observability",
  "version": "0.8.0",
  "description": "Unsupported internal RELKIT observability contracts; use @relkit/app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/observability"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    "./local/protocol": {
      "types": "./dist/local/protocol.d.ts",
      "import": "./dist/local/protocol.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "import": "./dist/local/index.js"
    },
    "./early": {
      "types": "./dist/early-records.service.d.ts",
      "import": "./dist/early-records.service.js"
    },
    "./local/record": {
      "types": "./dist/local/types.d.ts",
      "import": "./dist/local/types.js"
    },
    "./local/queue": {
      "types": "./dist/local/batch-queue-effect.d.ts",
      "import": "./dist/local/batch-queue-effect.js"
    },
    "./local/worker-contract": {
      "types": "./dist/local/worker-contract.d.ts",
      "import": "./dist/local/worker-contract.js"
    },
    "./internal/query": {
      "types": "./dist/query-validation.d.ts",
      "import": "./dist/query-validation.js"
    }
  },
  "dependencies": {
    "@relkit/contracts": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc -b && bun run scripts/prune-native-artifacts.ts",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage && bun run scripts/check-coverage.ts"
  }
}
