{
  "name": "@relkit/observability",
  "version": "0.2.0",
  "description": "Unsupported internal RELKIT observability contracts; use @relkit/app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/observability"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "import": "./dist/local/index.js"
    }
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@relkit/contracts": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
}
