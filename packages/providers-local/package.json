{
  "name": "@relkit/providers-local",
  "version": "0.0.3",
  "description": "Local runtime providers for RELKIT development and testing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/providers-local"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@relkit/agents": "workspace:*",
    "@relkit/app": "workspace:*",
    "@relkit/buckets": "workspace:*",
    "@relkit/cache": "workspace:*",
    "@relkit/contracts": "workspace:*",
    "@relkit/events": "workspace:*",
    "@relkit/jobs": "workspace:*",
    "@relkit/runtime-effect": "workspace:*",
    "cron-parser": "5.10.0"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
}
