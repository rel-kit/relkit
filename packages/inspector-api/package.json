{
  "name": "@relkit/inspector-api",
  "version": "0.5.6",
  "description": "Unsupported internal API for the RELKIT inspector; use @relkit/cli.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/inspector-api"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@relkit/contracts": "workspace:*",
    "@relkit/observability": "workspace:*",
    "@relkit/runtime-effect": "workspace:*",
    "hono": "4.13.5",
    "effect": "4.0.0-rc.115"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "vitest": "5.0.1"
  }
}
