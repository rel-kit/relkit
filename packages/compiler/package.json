{
  "name": "@relkit/compiler",
  "version": "0.0.4",
  "description": "Unsupported internal RELKIT source compiler; use @relkit/cli.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@relkit/contracts": "workspace:*",
    "@relkit/client-generator": "workspace:*",
    "@relkit/diagnostics": "workspace:*",
    "@relkit/graph": "workspace:*",
    "@relkit/openapi": "workspace:*",
    "@relkit/schema": "workspace:*",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false"
  }
}
