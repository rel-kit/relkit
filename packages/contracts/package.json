{
  "name": "@relkit/contracts",
  "version": "0.5.6",
  "description": "Unsupported internal RELKIT contracts; use @relkit/app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./operation": {
      "types": "./dist/operation.d.ts",
      "import": "./dist/operation.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "import": "./dist/jobs.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "@vitest/coverage-v8": "5.0.1",
    "vitest": "5.0.1"
  }
}
