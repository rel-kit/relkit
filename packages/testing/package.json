{
  "name": "@relkit/testing",
  "version": "0.7.10",
  "description": "Testing utilities and local providers for RELKIT applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal/fakes": {
      "types": "./dist/fakes.d.ts",
      "import": "./dist/fakes.js"
    },
    "./internal/jobs-utils": {
      "types": "./dist/jobs-utils.d.ts",
      "import": "./dist/jobs-utils.js"
    },
    "./internal/runtime-clock": {
      "types": "./dist/runtime-clock.d.ts",
      "import": "./dist/runtime-clock.js"
    },
    "./internal/testing-owner": {
      "types": "./dist/testing-owner.d.ts",
      "import": "./dist/testing-owner.js"
    },
    "./internal/work-ownership": {
      "types": "./dist/work-ownership.d.ts",
      "import": "./dist/work-ownership.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth.d.ts",
      "import": "./dist/better-auth.js"
    }
  },
  "dependencies": {
    "@relkit/buckets": "workspace:*",
    "@relkit/cache": "workspace:*",
    "@relkit/config": "workspace:*",
    "@relkit/compiler": "workspace:*",
    "@relkit/contracts": "workspace:*",
    "@relkit/engine": "workspace:*",
    "@relkit/events": "workspace:*",
    "@relkit/functions": "workspace:*",
    "@relkit/graph": "workspace:*",
    "@relkit/invocation": "workspace:*",
    "@relkit/jobs": "workspace:*",
    "@relkit/providers-local": "workspace:*",
    "@relkit/realtime": "workspace:*",
    "@relkit/runtime-effect": "workspace:*",
    "@relkit/runtime-hono": "workspace:*",
    "@relkit/schema": "workspace:*",
    "@relkit/tools": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@relkit/better-auth": "workspace:*",
    "@relkit/drizzle": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@relkit/better-auth": {
      "optional": true
    },
    "@relkit/drizzle": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -b && bun run ../../scripts/prune-moved-authoring-artifacts.ts testing",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false"
  },
  "devDependencies": {
    "@relkit/better-auth": "workspace:*",
    "@relkit/drizzle": "workspace:*",
    "@relkit/langchain": "workspace:*",
    "@effect/vitest": "catalog:",
    "@relkit/routes": "workspace:*",
    "drizzle-orm": "catalog:",
    "vitest": "catalog:"
  }
}
