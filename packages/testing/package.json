{
  "name": "@relkit/testing",
  "version": "0.8.4",
  "description": "Testing utilities and local providers for RelKit applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fakes": {
      "types": "./dist/fakes.d.ts",
      "import": "./dist/fakes.js"
    },
    "./agents-conformance": {
      "types": "./dist/agents-conformance.d.ts",
      "import": "./dist/agents-conformance.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./cache-conformance": {
      "types": "./dist/cache-conformance.d.ts",
      "import": "./dist/cache-conformance.js"
    },
    "./buckets-conformance": {
      "types": "./dist/buckets-conformance.d.ts",
      "import": "./dist/buckets-conformance.js"
    },
    "./realtime-conformance": {
      "types": "./dist/realtime-conformance.d.ts",
      "import": "./dist/realtime-conformance.js"
    },
    "./events-conformance": {
      "types": "./dist/events-conformance.d.ts",
      "import": "./dist/events-conformance.js"
    },
    "./jobs-conformance": {
      "types": "./dist/jobs-conformance.d.ts",
      "import": "./dist/jobs-conformance.js"
    },
    "./runtime-conformance": {
      "types": "./dist/runtime-conformance.d.ts",
      "import": "./dist/runtime-conformance.js"
    },
    "./deploy-target-conformance": {
      "types": "./dist/deploy-target-conformance.d.ts",
      "import": "./dist/deploy-target-conformance.js"
    },
    "./jobs-utils": {
      "types": "./dist/jobs-utils.d.ts",
      "import": "./dist/jobs-utils.js"
    },
    "./runtime-clock": {
      "types": "./dist/runtime-clock.d.ts",
      "import": "./dist/runtime-clock.js"
    },
    "./testing-owner": {
      "types": "./dist/testing-owner.d.ts",
      "import": "./dist/testing-owner.js"
    },
    "./work-ownership": {
      "types": "./dist/work-ownership.d.ts",
      "import": "./dist/work-ownership.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth.d.ts",
      "import": "./dist/better-auth.js"
    }
  },
  "dependencies": {
    "@relkit/cli": "workspace:*",
    "effect": "catalog:",
    "relkit": "workspace:*"
  },
  "peerDependencies": {
    "@relkit/better-auth": "workspace:*",
    "@relkit/drizzle": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@relkit/better-auth": {
      "optional": true
    },
    "@relkit/drizzle": {
      "optional": true
    }
  },
  "scripts": {
    "build:foundation": "tsc -p tsconfig.foundation.json --pretty false",
    "typecheck:foundation": "tsc -p tsconfig.foundation.json --pretty false",
    "build": "tsc -b && bun run ../../scripts/prune-moved-authoring-artifacts.ts testing",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@relkit/better-auth": "workspace:*",
    "@relkit/drizzle": "workspace:*",
    "@relkit/langchain": "workspace:*",
    "drizzle-orm": "catalog:",
    "vitest": "catalog:"
  },
  "relkit": {
    "maturity": "core"
  }
}
