{
  "name": "@relkit/realtime",
  "version": "0.7.2",
  "description": "Typed realtime channels and provider contracts for RELKIT.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rel-kit/relkit.git",
    "directory": "packages/realtime"
  },
  "homepage": "https://github.com/rel-kit/relkit#readme",
  "bugs": {
    "url": "https://github.com/rel-kit/relkit/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./operation-id": {
      "types": "./dist/operation-id.d.ts",
      "import": "./dist/operation-id.js"
    }
  },
  "dependencies": {
    "@relkit/contracts": "workspace:*",
    "@relkit/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:typecheck": "tsc -p tsconfig.test.json --pretty false"
  }
}
