{
  "name": "@relkit/example-auth-drizzle",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun ../../packages/cli/dist/bin.js dev",
    "check": "bun ../../packages/cli/dist/bin.js check",
    "typecheck": "bun ../../packages/cli/dist/bin.js check && tsc --noEmit",
    "test": "bun test",
    "build": "bun ../../packages/cli/dist/bin.js build",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate"
  },
  "dependencies": {
    "@relkit/app": "workspace:*",
    "@relkit/better-auth": "workspace:*",
    "@relkit/client": "workspace:*",
    "@relkit/drizzle": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@relkit/cli": "workspace:*",
    "@relkit/testing": "workspace:*",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
