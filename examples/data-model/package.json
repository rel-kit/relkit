{
  "name": "@relkit/example-data-model",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun ../../packages/cli/dist/index.js dev",
    "check": "bun ../../packages/cli/dist/index.js check",
    "typecheck": "bun ../../packages/cli/dist/index.js check && tsc --noEmit",
    "test": "bun test",
    "build": "bun ../../packages/cli/dist/index.js build",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate"
  },
  "dependencies": {
    "@relkit/app": "workspace:*",
    "@relkit/drizzle": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5-169397b"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@relkit/cli": "workspace:*",
    "@relkit/testing": "workspace:*",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "typescript": "5.9.3"
  }
}
