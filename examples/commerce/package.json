{
  "name": "@relkit/example-commerce",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun run setup && RELKIT_ALLOWED_ORIGINS=http://127.0.0.1:3000 bun ../../packages/cli/dist/bin.js dev",
    "setup": "bun src/setup.ts",
    "check": "bun ../../packages/cli/dist/bin.js check",
    "typecheck": "bun ../../packages/cli/dist/bin.js check && tsc --noEmit",
    "test": "bun test",
    "build": "bun ../../packages/cli/dist/bin.js build"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "0.12.9",
    "@langchain/core": "catalog:",
    "@langchain/langgraph": "catalog:",
    "@relkit/app": "workspace:*",
    "@relkit/aws": "workspace:*",
    "@relkit/better-auth": "workspace:*",
    "@relkit/client": "workspace:*",
    "@relkit/docker": "workspace:*",
    "@relkit/drizzle": "workspace:*",
    "@relkit/inngest": "workspace:*",
    "@relkit/langchain": "workspace:*",
    "@relkit/local": "workspace:*",
    "@relkit/otlp": "workspace:*",
    "@relkit/pulumi": "workspace:*",
    "@relkit/redis": "workspace:*",
    "@relkit/s3": "workspace:*",
    "@relkit/sentry": "workspace:*",
    "better-auth": "catalog:",
    "deepagents": "catalog:",
    "drizzle-orm": "catalog:",
    "langchain": "catalog:",
    "langsmith": "0.10.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250121.0",
    "@types/bun": "catalog:",
