{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "CIRCLE_NODE_TOTAL",
    "RAYON_NUM_THREADS",
    "NODE_OPTIONS",
    "RELKIT_DOCGEN_CONCURRENCY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx", "!**/tests/**"],
      "outputs": ["dist/**", ".relkit/build/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "create-relkit#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/templates/default/v1/**",
        "$TURBO_ROOT$/scripts/package-create-relkit-templates.ts"
      ],
      "outputs": ["dist/**"]
    },
    "@relkit/inspector#build": {
      "dependsOn": ["^build", "@relkit/inspector-ui#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/package-inspector.ts",
        "$TURBO_ROOT$/turbo.json"
      ],
      "outputs": ["dist/**"]
    },
    "@relkit/cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/prune-cli-output.ts",
        "$TURBO_ROOT$/scripts/package-dev-bootstrap.ts",
        "$TURBO_ROOT$/scripts/package-editor.ts",
        "$TURBO_ROOT$/turbo.json"
      ],
      "outputs": ["dist/**"]
    },
    "@relkit/cli#typecheck": {
      "cache": false
    },
    "@relkit/inspector#typecheck": {
      "cache": false
    },
    "create-relkit#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/templates/default/v1/**",
        "$TURBO_ROOT$/scripts/package-create-relkit-templates.ts"
      ],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "envMode": "loose"
    }
  }
}
