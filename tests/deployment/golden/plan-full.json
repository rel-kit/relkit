{
  "contractVersion": 2,
  "graphHash": "sha256:200cacd0eece3d57e5ef127e5f79eedfc9056919f052f44303d95b3702ca2557",
  "application": {
    "id": "full-app",
    "image": {
      "name": "registry.example/orders",
      "tag": "2026-08-18",
      "digest": "sha256:orders-image",
      "health": {
        "livenessPath": "/_zsys/v1/health/live",
        "readinessPath": "/_zsys/v1/health/ready",
        "port": 8080,
        "intervalMs": 10000,
        "timeoutMs": 2000
      }
    },
    "environmentNames": ["SERVICE_PORT"]
  },
  "providerBindings": [
    {
      "id": "provider.buckets.default",
      "capability": "buckets",
      "profile": "default",
      "adapter": "s3",
      "ownership": "managed",
      "configuration": {
        "bucketName": "assets",
        "endpoint": "https://s3.us-east-1.amazonaws.com",
        "region": "us-east-1"
      },
      "environment": []
    },
    {
      "id": "provider.events.default",
      "capability": "events",
      "profile": "default",
      "adapter": "eventbridge",
      "ownership": "managed",
      "configuration": {
        "busName": "events",
        "region": "us-east-1"
      },
      "environment": []
    },
    {
      "id": "provider.jobs.default",
      "capability": "jobs",
      "profile": "default",
      "adapter": "sqs",
      "ownership": "managed",
      "configuration": {
        "queueUrl": "https://sqs.us-east-1.amazonaws.com/1/jobs",
        "region": "us-east-1"
      },
      "environment": []
    }
  ],
  "http": {
    "logicalName": "full-app-http-public",
    "port": 8080,
    "health": {
      "livenessPath": "/_zsys/v1/health/live",
      "readinessPath": "/_zsys/v1/health/ready",
      "port": 8080,
      "intervalMs": 10000,
      "timeoutMs": 2000
    },
    "routes": [
      {
        "id": "orders.get-route",
        "method": "GET",
        "path": "/orders/:orderId",
        "targetFunctionId": "orders.get"
      }
    ],
    "configurationNames": ["SERVICE_PORT"]
  },
  "jobs": [
    {
      "id": "receipts.send-job",
      "logicalName": "full-app-job-receipts-send-job",
      "bindingId": "provider.jobs.default",
      "profile": "default",
      "configurationNames": [],
      "capabilities": ["jobs"],
      "tags": {
        "app": "full-app",
        "graphHash": "sha256:200cacd0eece3d57e5ef127e5f79eedfc9056919f052f44303d95b3702ca2557",
        "managed-by": "zsys"
      },
      "metadata": {
        "iamCapabilities": [
          "sqs:ReceiveMessage",
          "sqs:DeleteMessage",
          "sqs:ChangeMessageVisibility",
          "sqs:SendMessage"
        ]
      },
      "targetFunctionId": "receipts.send",
      "retry": {
        "initialDelayMs": 1,
        "jitter": "none",
        "maxAttempts": 2,
        "maxDelayMs": 5,
        "multiplier": 2
      },
      "idempotency": {
        "key": "orderId",
        "retentionMs": 1000
      }
    }
  ],
  "schedules": [
    {
      "id": "receipts.reconcile",
      "logicalName": "full-app-schedule-receipts-reconcile",
      "bindingId": "provider.jobs.default",
      "profile": "default",
      "configurationNames": [],
      "capabilities": ["jobs"],
      "tags": {
        "app": "full-app",
        "graphHash": "sha256:200cacd0eece3d57e5ef127e5f79eedfc9056919f052f44303d95b3702ca2557",
        "managed-by": "zsys"
      },
      "jobId": "receipts.send-job",
      "schedule": {
        "cron": "0 * * * *",
        "id": "receipts.reconcile",
        "input": {
          "orderId": "scheduled"
        },
        "overlap": "skip",
        "timezone": "UTC"
      }
    }
  ],
  "events": [
    {
      "id": "orders.created",
      "logicalName": "full-app-event-orders-created",
      "bindingId": "provider.events.default",
      "profile": "default",
      "configurationNames": [],
      "capabilities": ["events"],
      "tags": {
        "app": "full-app",
        "graphHash": "sha256:200cacd0eece3d57e5ef127e5f79eedfc9056919f052f44303d95b3702ca2557",
        "managed-by": "zsys"
      },
      "metadata": {
        "iamCapabilities": ["events:PutEvents"]
      },
      "version": 1,
      "payload": {
        "properties": {
          "orderId": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          }
        },
        "required": ["orderId", "sku"],
        "type": "object"
      }
    }
  ],
  "eventTriggers": [
    {
      "id": "orders.listener",
      "logicalName": "full-app-event-trigger-orders-listener",
      "bindingId": "provider.events.default",
      "profile": "default",
      "configurationNames": [],
      "capabilities": ["events"],
      "tags": {
        "app": "full-app",
        "graphHash": "sha256:200cacd0eece3d57e5ef127e5f79eedfc9056919f052f44303d95b3702ca2557",
        "managed-by": "zsys"
      },
      "metadata": {
        "iamCapabilities": [
          "sqs:ReceiveMessage",
          "sqs:DeleteMessage",
          "sqs:ChangeMessageVisibility"
        ]
      },
      "targetFunctionId": "zsys.event.orders.listener.handler",
      "expansion": ["orders.created@1"],
      "delivery": "durable",
      "retry": {
        "initialDelayMs": 1,
        "jitter": "none",
        "maxAttempts": 2,
        "maxDelayMs": 5,
        "multiplier": 2
      }
    }
  ],
  "buckets": [
    {
      "id": "assets",
      "logicalName": "full-app-bucket-assets",
      "bindingId": "provider.buckets.default",
      "profile": "default",
      "configurationNames": [],
      "capabilities": ["buckets"],
      "tags": {
        "app": "full-app",
        "graphHash": "sha256:200cacd0eece3d57e5ef127e5f79eedfc9056919f052f44303d95b3702ca2557",
        "managed-by": "zsys"
      },
      "visibility": "private",
      "maxObjectBytes": 10000,
      "allowedContentTypes": ["application/json"]
    }
  ],
  "caches": [],
  "iam": {
    "serviceRole": {
      "statements": [
        {
          "capability": "events",
          "actions": ["events:PutEvents"],
          "resources": ["full-app-event-orders-created"]
        },
        {
          "capability": "jobs",
          "actions": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility"],
          "resources": ["full-app-job-receipts-send-job"]
        },
        {
          "capability": "jobs",
          "actions": [
            "sqs:ReceiveMessage",
            "sqs:DeleteMessage",
            "sqs:ChangeMessageVisibility",
            "sqs:GetQueueAttributes"
          ],
          "resources": ["full-app-event-trigger-orders-listener"]
        },
        {
          "capability": "jobs",
          "actions": ["sqs:SendMessage"],
          "resources": ["full-app-job-receipts-send-job"]
        }
      ]
    },
    "perFunction": [
      {
        "functionId": "orders.create",
        "capability": "events",
        "resourceId": "orders.created",
        "actions": ["events:PutEvents"]
      },
      {
        "functionId": "orders.handle-created",
        "capability": "jobs",
        "resourceId": "receipts.send-job",
        "actions": ["sqs:SendMessage"]
      },
      {
        "functionId": "receipts.send",
        "capability": "jobs",
        "resourceId": "receipts.send-job",
        "actions": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility"]
      },
      {
        "functionId": "zsys.event.orders.listener.handler",
        "capability": "jobs",
        "resourceId": "orders.listener",
        "actions": [
          "sqs:ReceiveMessage",
          "sqs:DeleteMessage",
          "sqs:ChangeMessageVisibility",
          "sqs:GetQueueAttributes"
        ]
      },
      {
        "functionId": "zsys.event.orders.listener.handler",
        "capability": "jobs",
        "resourceId": "receipts.send-job",
        "actions": ["sqs:SendMessage"]
      }
    ]
  }
}
