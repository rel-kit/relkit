      readonly "billing.example-event": typeof exampleEvent;
    }
  }
}

export default exampleEvent;
"
,
      "path": "src/billing/events/example.event.ts",
    },
    {
      "action": "create",
      "content": 
"import { defineFunction } from "@relkit/app/functions";
import { z } from "@relkit/app/schema";
import exampleError from "@app/billing/errors/example.error.js";

const example = defineFunction({
  id: "billing.example",
  input: z.object({ value: z.string().default("example") }),
  output: z.object({ value: z.string() }),
  errors: [exampleError],
  publishes: ["billing.example-event"],
  handler: async ({ value }, context) => {
    if (value === "error") return exampleError.create({ message: "Example failure" });
    await context.events["billing.example-event"].publish({ value });
    return { value };
  },
});

export default example;
"
,
      "path": "src/billing/functions/example.function.ts",
    },
    {
      "action": "create",
      "content": 
"import { defineEventFunction } from "@relkit/app/events";

const onExample = defineEventFunction({
  id: "billing.on-example",
  event: "billing.example-event",
  delivery: "durable",
  profile: "local",
  handler: async ({ value }, context) => {
    context.log.info("on-example", { value });
  },
});

export default onExample;
"
,
      "path": "src/billing/functions/on-example.function.ts",
